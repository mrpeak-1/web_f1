---
// HelmetScrub.astro: The Official Helmet Vault & Hall of Fame for JAMES // J4
// Uses 100% authentic helmets from landonorris.com with real WebP images & interactive modal
---

<section id="helmet-vault" class="relative min-h-screen py-24 px-4 sm:px-6 md:px-12 bg-transparent text-white overflow-hidden select-none">
  <!-- Ambient Volt Glow -->
  <div class="pointer-events-none absolute top-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-[#E0FF00]/10 rounded-full blur-[170px]"></div>

  <!-- Header -->
  <div class="max-w-7xl mx-auto mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-neutral-800 pb-8">
    <div class="space-y-2">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2.5 h-2.5 bg-[#E0FF00] shadow-[0_0_10px_#E0FF00]"></span>
        <span class="font-mono text-xs uppercase tracking-widest text-[#E0FF00] font-bold">SECTION 04 // THE HELMET VAULT</span>
      </div>
      <h2 class="text-4xl sm:text-6xl md:text-7xl font-serif font-black uppercase tracking-tight text-white">
        HELMETS <span class="text-neutral-500 font-mono font-light text-2xl sm:text-4xl">/</span> <span class="text-[#E0FF00]">HALL OF FAME</span>
      </h2>
    </div>

    <div class="max-w-md">
      <p class="font-serif italic text-sm text-neutral-300">
        "Every circuit demands a bespoke statement. Bell HP77 carbon helmets crafted for James with aerodynamic efficiency, ballistic protection, and signature electric volt geometry."
      </p>
    </div>
  </div>

  <!-- Real High-Res Photography Spotlight Row (Replaced vegetable with official helmet hero images!) -->
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
    <div class="group relative rounded-3xl overflow-hidden bg-black border border-neutral-800 h-80 sm:h-96 shadow-2xl flex items-center justify-center p-6">
      <img 
        src="/images/helmets/footer_helm_hero.webp" 
        alt="James Driver Helmet Official Hero" 
        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-700 drop-shadow-[0_20px_35px_rgba(0,0,0,0.9)]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
      <div class="absolute bottom-6 left-6 right-6 flex items-end justify-between z-10">
        <div>
          <span class="px-2.5 py-1 rounded bg-[#E0FF00] text-black font-mono text-[10px] font-bold uppercase mb-1 inline-block">OFFICIAL LID</span>
          <h4 class="text-2xl sm:text-3xl font-serif font-black text-white">DARK MODE VOLT LIVERY</h4>
          <p class="font-mono text-xs text-neutral-300">Bell HP77 Carbon // FIA 8860-2018 ABP</p>
        </div>
        <span class="w-3 h-3 rounded-full bg-[#E0FF00] animate-ping"></span>
      </div>
    </div>

    <div class="group relative rounded-3xl overflow-hidden bg-black border border-neutral-800 h-80 sm:h-96 shadow-2xl flex items-center justify-center p-6">
      <img 
        src="/images/helmets/discoball.webp" 
        alt="Discoball Special Helmet Edition" 
        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-700 drop-shadow-[0_20px_35px_rgba(0,0,0,0.9)]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
      <div class="absolute bottom-6 left-6 right-6 flex items-end justify-between z-10">
        <div>
          <span class="px-2.5 py-1 rounded bg-fuchsia-600 text-white font-mono text-[10px] font-bold uppercase mb-1 inline-block">2025 SPECIAL</span>
          <h4 class="text-2xl sm:text-3xl font-serif font-black text-white">DISCOBALL CHROME EDITION</h4>
          <p class="font-mono text-xs text-neutral-300">Mirrored Prismatic Refraction Finish</p>
        </div>
        <span class="w-3 h-3 rounded-full bg-fuchsia-500 animate-ping"></span>
      </div>
    </div>
  </div>

  <!-- Interactive 3D Helmet Viewer & Specs -->
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mb-20">
    <!-- Left Column: Specs -->
    <div class="lg:col-span-4 space-y-6">
      <div class="p-6 rounded-3xl bg-neutral-900/80 border border-neutral-800 backdrop-blur-md shadow-xl">
        <span class="font-mono text-[10px] text-[#E0FF00] tracking-widest uppercase font-bold block mb-4">
          AERODYNAMIC ARCHITECTURE
        </span>
        <div class="space-y-4 text-xs font-mono">
          <div class="border-b border-neutral-800 pb-2 flex justify-between">
            <span class="text-neutral-400">BASE CHASSIS</span>
            <span class="text-white font-bold">BELL HP77 CARBON</span>
          </div>
          <div class="border-b border-neutral-800 pb-2 flex justify-between">
            <span class="text-neutral-400">HOMOLOGATION</span>
            <span class="text-white font-bold">FIA 8860-2018 ABP</span>
          </div>
          <div class="border-b border-neutral-800 pb-2 flex justify-between">
            <span class="text-neutral-400">SHELL WEIGHT</span>
            <span class="text-[#E0FF00] font-bold">1,280 GRAMS</span>
          </div>
          <div class="border-b border-neutral-800 pb-2 flex justify-between">
            <span class="text-neutral-400">BALLISTIC STRIP</span>
            <span class="text-white font-bold">50mm ZYLON OVERLAP</span>
          </div>
          <div class="flex justify-between">
            <span class="text-neutral-400">VISOR BROADCAST</span>
            <span class="text-white font-bold">4K DRIVER EYE-CAM</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Center Column: Active Main Helmet Showcase -->
    <div class="lg:col-span-8 flex flex-col items-center">
      <div class="relative w-full h-[420px] sm:h-[480px] rounded-3xl bg-radial from-neutral-900 via-neutral-950 to-black border border-neutral-800 shadow-[0_0_80px_rgba(0,0,0,0.95)] flex items-center justify-center p-8 overflow-hidden group">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(224,255,0,0.15),transparent_70%)]"></div>
        
        <!-- Live Selected Helmet Display Image -->
        <img 
          id="main-spotlight-helmet"
          src="/images/helmets/season_2025.webp" 
          alt="Main Spotlight Helmet" 
          class="relative z-10 w-72 sm:w-80 h-auto object-contain group-hover:scale-110 transition-transform duration-500 drop-shadow-[0_25px_45px_rgba(0,0,0,0.9)]"
        />

        <div class="absolute bottom-6 left-6 z-20">
          <span class="font-mono text-xs text-[#E0FF00] font-bold block" id="spotlight-title">SEASON 2025 LIVERY</span>
          <span class="font-serif italic text-sm text-neutral-300" id="spotlight-subtitle">Official #4 FIA Championship Standard</span>
        </div>

        <div class="absolute top-6 right-6 z-20 px-3 py-1 rounded-full bg-black/80 border border-neutral-800 font-mono text-[10px] text-neutral-400">
          HOVER OR CLICK TO INSPECT
        </div>
      </div>
    </div>
  </div>

  <!-- Helmets Hall of Fame Grid (EXACT replica from landonorris.com screenshot) -->
  <div class="max-w-7xl mx-auto border-t border-neutral-800 pt-16">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <span class="font-mono text-xs text-[#E0FF00] tracking-widest uppercase block mb-1 font-bold">ARCHIVE COLLECTION</span>
        <h3 class="text-2xl sm:text-3xl font-serif font-black text-white">HISTORIC LID GALLERY</h3>
      </div>
      <span class="font-mono text-xs text-neutral-400 uppercase tracking-wider">OFFICIAL HELMETS FROM LANDONORRIS.COM</span>
    </div>

    <!-- Gallery Grid with Exact Cards from landonorris.com Reference -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 sm:gap-6">
      {[
        { name: "Season 2025", year: "2025", img: "/images/helmets/season_2025.webp", pole: "P1", speed: "354 KM/H", laps: 78, desc: "Electric Volt + Matte Carbon stealth geometry" },
        { name: "Discoball", year: "2025", img: "/images/helmets/discoball.webp", pole: "P1", speed: "351 KM/H", laps: 56, desc: "Mirrored Prismatic reflective squares" },
        { name: "Dark Mode", year: "2024", img: "/images/helmets/dark_glitter.webp", pole: "P1", speed: "358 KM/H", laps: 53, desc: "Liquid volt zebra pattern over carbon weave" },
        { name: "Porcelain", year: "2024", img: "/images/helmets/porcelain.webp", pole: "P2", speed: "348 KM/H", laps: 56, desc: "Traditional blue and white ceramic floral glaze" },
        { name: "Japan", year: "2024", img: "/images/helmets/japan.webp", pole: "P1", speed: "340 KM/H", laps: 53, desc: "Suzuka cherry blossom & metallic purple chrome" },
        { name: "Chrome", year: "2023", img: "/images/helmets/chrome.webp", pole: "P1", speed: "354 KM/H", laps: 52, desc: "Full mirror chrome finish reflecting Silverstone skies" },
        { name: "Las Vegas", year: "2023", img: "/images/helmets/las_vegas.webp", pole: "P2", speed: "356 KM/H", laps: 50, desc: "Golden card deck & scales under the Strip lights" },
        { name: "Beachball", year: "2023", img: "/images/helmets/beachball.webp", pole: "P3", speed: "346 KM/H", laps: 57, desc: "Miami GP inflatable beach ball paneling" },
        { name: "Basketball", year: "2022", img: "/images/helmets/basketball.webp", pole: "P3", speed: "344 KM/H", laps: 58, desc: "Textured composite pebble grain basketball design" },
        { name: "Silverstone", year: "2020", img: "/images/helmets/silverstone.webp", pole: "P1", speed: "355 KM/H", laps: 52, desc: "Hand-drawn fan artwork home race special" },
        { name: "Base 2021", year: "2021", img: "/images/helmets/base_2021.webp", pole: "P1", speed: "350 KM/H", laps: 72, desc: "Monaco GP podium retro matte volt" },
        { name: "Season 2024", year: "2024", img: "/images/helmets/season_2024.webp", pole: "P1", speed: "352 KM/H", laps: 71, desc: "Championship contender neon yellow & dark blue" }
      ].map((item) => (
        <div 
          class="helmet-archive-card group relative rounded-2xl bg-neutral-900/90 border border-neutral-800 hover:border-[#E0FF00] p-4 transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_15px_30px_rgba(224,255,0,0.15)] cursor-pointer flex flex-col justify-between"
          data-helmet={JSON.stringify(item)}
        >
          <!-- Helmet Isolated Image Container -->
          <div class="w-full aspect-square rounded-xl bg-black flex items-center justify-center p-3 relative overflow-hidden mb-3">
            <div class="absolute inset-0 bg-radial from-neutral-800/20 to-transparent"></div>
            <img 
              src={item.img} 
              alt={item.name} 
              class="w-full h-full object-contain group-hover:scale-115 transition-transform duration-500 drop-shadow-[0_10px_20px_rgba(0,0,0,0.8)]"
            />
          </div>

          <!-- Card Label (Exact style from landonorris.com screenshot) -->
          <div class="flex items-center justify-between font-mono text-xs pt-1 border-t border-neutral-800/80">
            <span class="text-white font-bold group-hover:text-[#E0FF00] transition-colors">{item.name}</span>
            <span class="text-[#E0FF00] font-black">{item.year}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Interactive Helmet Inspector Modal -->
  <div id="helmet-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-xl opacity-0 pointer-events-none transition-opacity duration-300 p-4">
    <div class="relative w-full max-w-lg rounded-3xl bg-[#0F0F0F] border border-neutral-700 p-6 sm:p-8 shadow-2xl">
      <button id="modal-close" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-neutral-800 text-white flex items-center justify-center hover:bg-[#E0FF00] hover:text-black transition-colors font-mono font-bold">
        ✕
      </button>

      <!-- Modal Image View -->
      <div class="w-48 h-48 mx-auto flex items-center justify-center mb-4">
        <img id="modal-img" src="" alt="Helmet Preview" class="w-full h-full object-contain drop-shadow-[0_15px_30px_rgba(0,0,0,0.9)]" />
      </div>

      <div class="flex items-center gap-3 mb-2">
        <span class="px-3 py-1 rounded bg-[#E0FF00] text-black font-mono font-bold text-xs" id="modal-badge">2024 GP</span>
        <span class="font-mono text-xs text-neutral-400" id="modal-name">BELL HP77 SPECIAL</span>
      </div>

      <h3 class="text-3xl font-serif font-black uppercase text-white mb-2" id="modal-title">MONACO GRAND PRIX</h3>
      <p class="font-sans text-xs text-neutral-300 mb-4" id="modal-desc"></p>

      <div class="grid grid-cols-3 gap-3 my-4 font-mono text-xs">
        <div class="p-3 rounded-xl bg-neutral-900 border border-neutral-800">
          <span class="text-neutral-500 block">QUALIFYING</span>
          <span class="text-[#E0FF00] font-bold text-base" id="modal-pole">POLE P1</span>
        </div>
        <div class="p-3 rounded-xl bg-neutral-900 border border-neutral-800">
          <span class="text-neutral-500 block">MAX SPEED</span>
          <span class="text-white font-bold text-base" id="modal-speed">354 KM/H</span>
        </div>
        <div class="p-3 rounded-xl bg-neutral-900 border border-neutral-800">
          <span class="text-neutral-500 block">RACE DISTANCE</span>
          <span class="text-white font-bold text-base" id="modal-laps">78 LAPS</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { f1Audio } from '../utils/audio';

  const spotlightImg = document.getElementById('main-spotlight-helmet') as HTMLImageElement;
  const spotlightTitle = document.getElementById('spotlight-title');
  const spotlightSubtitle = document.getElementById('spotlight-subtitle');

  const modal = document.getElementById('helmet-modal');
  const modalClose = document.getElementById('modal-close');
  const modalImg = document.getElementById('modal-img') as HTMLImageElement;
  const modalBadge = document.getElementById('modal-badge');
  const modalName = document.getElementById('modal-name');
  const modalTitle = document.getElementById('modal-title');
  const modalDesc = document.getElementById('modal-desc');
  const modalPole = document.getElementById('modal-pole');
  const modalSpeed = document.getElementById('modal-speed');
  const modalLaps = document.getElementById('modal-laps');

  document.querySelectorAll('.helmet-archive-card').forEach((card) => {
    card.addEventListener('mouseenter', () => {
      const dataStr = card.getAttribute('data-helmet');
      if (!dataStr) return;
      const data = JSON.parse(dataStr);
      if (spotlightImg) spotlightImg.src = data.img;
      if (spotlightTitle) spotlightTitle.innerText = `${data.name.toUpperCase()} (${data.year})`;
      if (spotlightSubtitle) spotlightSubtitle.innerText = data.desc;
    });

    card.addEventListener('click', () => {
      f1Audio.playClick(1.8);
      const dataStr = card.getAttribute('data-helmet');
      if (!dataStr) return;
      const data = JSON.parse(dataStr);

      if (modalImg) modalImg.src = data.img;
      if (modalBadge) modalBadge.innerText = `${data.year} EDITION`;
      if (modalName) modalName.innerText = data.name;
      if (modalTitle) modalTitle.innerText = `${data.name.toUpperCase()}`;
      if (modalDesc) modalDesc.innerText = data.desc;
      if (modalPole) modalPole.innerText = data.pole;
      if (modalSpeed) modalSpeed.innerText = data.speed;
      if (modalLaps) modalLaps.innerText = `${data.laps} LAPS`;

      if (modal) {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100', 'pointer-events-auto');
      }
    });
  });

  modalClose?.addEventListener('click', () => {
    f1Audio.playClick(1.0);
    if (modal) {
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
    }
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
    }
  });
</script>
