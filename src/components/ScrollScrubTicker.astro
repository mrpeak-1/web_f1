---
// ScrollScrubTicker.astro: Massive Kinetic Typography Marquee scrubbing with ScrollTrigger
---

<div class="relative py-14 overflow-hidden border-y border-neutral-800/80 bg-black/40 backdrop-blur-sm select-none">
  <!-- Top Ambient Glow Line -->
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#E0FF00]/50 to-transparent"></div>

  <!-- Left to Right Flowing Track -->
  <div id="ticker-track-1" class="flex whitespace-nowrap will-change-transform">
    {Array.from({ length: 4 }).map(() => (
      <div class="flex items-center gap-8 text-5xl sm:text-7xl md:text-8xl lg:text-9xl font-serif font-black uppercase tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-neutral-200 via-white to-neutral-400 px-4">
        <span>JAMES</span>
        <span class="text-[#E0FF00] italic font-serif">#4</span>
        <span class="text-neutral-700 font-mono text-3xl sm:text-5xl font-light">//</span>
        <span class="text-[#E0FF00]">354 KM/H</span>
        <span class="text-neutral-700 font-mono text-3xl sm:text-5xl font-light">//</span>
        <span>WORLD TITLE CONTENDER</span>
        <span class="text-neutral-700 font-mono text-3xl sm:text-5xl font-light">//</span>
        <span class="italic text-neutral-400">McLAREN F1</span>
        <span class="text-neutral-700 font-mono text-3xl sm:text-5xl font-light">//</span>
      </div>
    ))}
  </div>

  <!-- Reverse Flowing Telemetry Track -->
  <div id="ticker-track-2" class="flex whitespace-nowrap mt-3 will-change-transform opacity-70">
    {Array.from({ length: 4 }).map(() => (
      <div class="flex items-center gap-6 font-mono text-xs sm:text-sm uppercase tracking-[0.4em] text-[#E0FF00] font-bold px-4">
        <span>MCL38 POWER UNIT</span>
        <span class="text-neutral-600">•</span>
        <span>1,020 HP HYBRID</span>
        <span class="text-neutral-600">•</span>
        <span>LATERAL 5.4G</span>
        <span class="text-neutral-600">•</span>
        <span>MONACO GP POLE</span>
        <span class="text-neutral-600">•</span>
        <span>DRS ACTIVE</span>
        <span class="text-neutral-600">•</span>
        <span>BRAKE DECEL -5.4G</span>
        <span class="text-neutral-600">•</span>
      </div>
    ))}
  </div>

  <!-- Bottom Ambient Glow Line -->
  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-[#E0FF00]/50 to-transparent"></div>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const track1 = document.getElementById('ticker-track-1');
  const track2 = document.getElementById('ticker-track-2');

  // Scrub horizontal displacement with Lenis / ScrollTrigger
  if (track1 && track2) {
    gsap.to(track1, {
      xPercent: -25,
      ease: "none",
      scrollTrigger: {
        trigger: track1,
        start: "top bottom",
        end: "bottom top",
        scrub: 0.8
      }
    });

    gsap.to(track2, {
      xPercent: 20,
      ease: "none",
      scrollTrigger: {
        trigger: track2,
        start: "top bottom",
        end: "bottom top",
        scrub: 0.8
      }
    });
  }
</script>

